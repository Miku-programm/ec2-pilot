# Copy to .env and choose your own password (at least 12 characters).
PANEL_ADMIN_PASSWORD=
# Keep 0 for http://127.0.0.1. Use 1 when serving through HTTPS.
PANEL_SECURE_COOKIE=0
# Comma-separated hostnames without scheme or port. Add your domain for HTTPS.
PANEL_ALLOWED_HOSTS=localhost,127.0.0.1,::1
# internal runs cron expressions in the persistent backend, including Docker.
# external is only for a separately installed Linux crontab worker.
PANEL_SCHEDULER=internal
